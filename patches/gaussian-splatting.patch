+def masked_ssim(img1, img2, valid_mask, window_size=11, eps=1e-8):
+    """SSIM averaged only at valid pixel centers.
+
+    Invalid prediction pixels are replaced by detached ground truth before the
+    SSIM window is evaluated.  They therefore contribute neither direct error
+    nor gradient, while valid centers close to a mask boundary remain usable.
+    """
+    if img1.ndim == 3:
+        img1 = img1.unsqueeze(0)
+        img2 = img2.unsqueeze(0)
+    if valid_mask.ndim == 3:
+        valid_mask = valid_mask.unsqueeze(0)
+    valid_mask = valid_mask.to(device=img1.device, dtype=img1.dtype)
+    masked_img1 = img1 * valid_mask + img2.detach() * (1.0 - valid_mask)
+    channel = img1.size(1)
+    window = create_window(window_size, channel).to(device=img1.device, dtype=img1.dtype)
+
+    mu1 = F.conv2d(masked_img1, window, padding=window_size // 2, groups=channel)
+    mu2 = F.conv2d(img2, window, padding=window_size // 2, groups=channel)
+    mu1_sq = mu1.pow(2)
+    mu2_sq = mu2.pow(2)
+    mu1_mu2 = mu1 * mu2
+    sigma1_sq = F.conv2d(
+        masked_img1 * masked_img1, window, padding=window_size // 2, groups=channel
+    ) - mu1_sq
+    sigma2_sq = F.conv2d(
+        img2 * img2, window, padding=window_size // 2, groups=channel
+    ) - mu2_sq
+    sigma12 = F.conv2d(
+        masked_img1 * img2, window, padding=window_size // 2, groups=channel
+    ) - mu1_mu2
+    ssim_map = ((2 * mu1_mu2 + C1) * (2 * sigma12 + C2)) / (
+        (mu1_sq + mu2_sq + C1) * (sigma1_sq + sigma2_sq + C2)
+    )
+    ssim_per_pixel = ssim_map.mean(dim=1, keepdim=True)
+    return (ssim_per_pixel * valid_mask).sum() / valid_mask.sum().clamp_min(eps)
+
 
