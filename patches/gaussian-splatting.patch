new file mode 100644
index 0000000000000000000000000000000000000000..859f45067d984eebc5cfdc04933348b51244cec5
--- /dev/null
+++ b/utils/sky_mask_utils.py
@@ -0,0 +1,53 @@
+"""Optional per-image valid-pixel masks for 3DGS supervision."""
+
+from pathlib import Path
+
+import cv2
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+
+class ValidMaskSupervisor:
+    """Load valid-pixel masks named after COLMAP images.
+
+    The repository convention is ``255=valid/supervised`` and
+    ``0=invalid/ignored``.  Sky and dynamic-object masking share this storage
+    convention even though their loss behavior is different.
+    """
+
+    def __init__(self, mask_dir):
+        self.path = Path(mask_dir).expanduser().resolve()
+        if not self.path.is_dir():
+            raise FileNotFoundError(f"Mask directory does not exist: {self.path}")
+        self.masks = {}
+        for path in sorted(self.path.glob("*.png")):
+            mask = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)
+            if mask is None:
+                raise ValueError(f"Unable to read mask: {path}")
+            self.masks[path.stem] = mask.astype(np.float32) / 255.0
+        if not self.masks:
+            raise ValueError(f"No PNG masks found in {self.path}")
+        self.valid_fraction = float(
+            sum(float(mask.sum()) for mask in self.masks.values())
+            / sum(mask.size for mask in self.masks.values())
+        )
+
+    def _mask_for_camera(self, camera):
+        name = Path(str(camera.image_name)).stem
+        if name not in self.masks:
+            raise KeyError(f"Camera {camera.image_name!r} has no mask in {self.path}")
+        return self.masks[name]
+
+    def target_for(self, camera, device="cuda"):
+        mask = torch.from_numpy(self._mask_for_camera(camera))[None, None].to(device)
+        return F.interpolate(
+            mask,
+            size=(camera.image_height, camera.image_width),
+            mode="bilinear",
+            align_corners=False,
+        )[0].clamp(0, 1)
+
+
+# Backward-compatible name used by the existing sky pipeline.
+SkyMaskSupervisor = ValidMaskSupervisor
diff --git a/complete_sanhuan_sam31_road_masks.py b/complete_sanhuan_sam31_road_masks.py
new file mode 100644
index 0000000000000000000000000000000000000000..4506b730c8f981274db1b83de4d4813b6d42a399
--- /dev/null
+++ b/complete_sanhuan_sam31_road_masks.py
@@ -0,0 +1,147 @@
+#!/usr/bin/env python3
+"""SAM3.1 road + nearby lane paint; audit all frames without changing geometry.
+
+Hough-derived paint candidates are used ONLY to assess coverage, never to
+create masks. Coverage statistics are not a ground-truth segmentation score.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+
+import cv2
+import numpy as np
+from scipy.ndimage import binary_fill_holes
+
+
+def main_component(mask):
+    count, labels, stats, _ = cv2.connectedComponentsWithStats(mask.astype(np.uint8), 8)
+    if count < 2:
+        raise ValueError("No road component")
+    return labels == (1 + np.argmax(stats[1:, cv2.CC_STAT_AREA]))
+
+
+def merge_masks(road, lane, valid, maximum_gap=16):
+    # Main carriageway only: disconnected sidewalk/side-road detections do not
+    # establish road planes. Existing vehicle exclusions remain authoritative.
+    main = main_component(road & valid)
+    distance = cv2.distanceTransform((~main).astype(np.uint8), cv2.DIST_L2, 5)
+    nearby_lane = lane & (distance <= maximum_gap) & valid
+    combined = main | nearby_lane
+    # Join the small segmentation gap between the observed edge paint and road.
+    # No extrapolation of a line, no dilation beyond actual SAM paint pixels.
+    h, w = road.shape
+    yy, xx = np.indices(road.shape)
+    present = main.any(axis=0)
+    old_top = np.argmax(main, axis=0)
+    boundary_paint = nearby_lane & (xx < .48*w) & (yy > .58*h)
+    boundary_paint &= (yy < old_top[None]) & (old_top[None]-yy <= maximum_gap)
+    columns = boundary_paint.any(axis=0) & present
+    paint_top = np.argmax(boundary_paint, axis=0)
+    gap = columns[None] & (yy >= paint_top[None]) & (yy < old_top[None])
+    combined |= gap & valid
+    combined = binary_fill_holes(combined) & valid
+    if np.any(combined & ~valid):
+        raise RuntimeError("Vehicle pixels leaked into road mask")
+    return combined, dict(sam_main_road_pixels=int(main.sum()),
+                          accepted_lane_pixels=int(nearby_lane.sum()),
+                          lane_pixels_outside_main_road=int((nearby_lane & ~main).sum()),
+                          joined_gap_pixels=int((gap & valid & ~road & ~lane).sum()),
+                          discarded_disconnected_road_pixels=int((road & valid & ~main).sum()))
+
+
+def paint_candidates(rgb, record):
+    h, w = rgb.shape[:2]
+    yy, xx = np.indices((h, w))
+    line = record["line_slope"]*xx+record["line_intercept"]
+    low = rgb.min(axis=2)
+    chroma = rgb.max(axis=2).astype(int)-low
+    return ((abs(yy-line) <= 2) & (xx < .44*w) & (yy > .60*h)
+            & (low > 140) & (chroma < 40))
+
+
+def overlay(rgb, mask):
+    result = rgb.copy()
+    result[mask] = .68*rgb[mask]+.32*np.array([0, 255, 0])
+    # Outline improves visibility of excluded paint without covering its color.
+    contours, _ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+    cv2.drawContours(result, contours, -1, (0, 255, 255), 1)
+    return result
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--images", type=Path, required=True)
+    parser.add_argument("--old-masks", type=Path, required=True)
+    parser.add_argument("--road-masks", type=Path, required=True)
+    parser.add_argument("--lane-masks", type=Path, required=True)
+    parser.add_argument("--vehicle-valid", type=Path, required=True)
+    parser.add_argument("--paint-reference", type=Path, required=True)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    if args.output.exists():
+        raise FileExistsError(args.output)
+    references = {r["image"]: r for r in json.loads(args.paint_reference.read_text())["records"]}
+    paths = sorted(args.images.glob("*.jpg"))
+    if len(paths) != 100:
+        raise ValueError("Expected the unchanged 100-frame sanhuan sequence")
+    results, records, previews, zooms, inputs = [], [], [], [], {}
+    for index, path in enumerate(paths):
+        rgb = cv2.cvtColor(cv2.imread(str(path)), cv2.COLOR_BGR2RGB)
+        masks = []
+        for directory in (args.old_masks, args.road_masks, args.lane_masks, args.vehicle_valid):
+            mask_path = directory/f"{path.stem}.png"
+            mask = cv2.imread(str(mask_path), 0)
+            if mask is None or mask.shape != rgb.shape[:2]:
+                raise ValueError(f"Missing or misaligned mask: {mask_path}")
+            inputs[str(mask_path.resolve())] = hashlib.sha256(mask_path.read_bytes()).hexdigest()
+            masks.append(mask > 128)
+        old, road, lane, valid = masks
+        final, details = merge_masks(road, lane, valid)
+        candidate = paint_candidates(rgb, references[path.name]) & valid
+        n = int(candidate.sum())
+        cover = {label: int((candidate & mask).sum()) for label, mask in
+                 (("old", old), ("road_no_erosion", road & valid), ("sam_lane", lane & valid), ("final", final))}
+        record = dict(image=path.name, index=index, candidate_pixels=n, covered_candidate_pixels=cover,
+                      final_candidate_coverage=cover["final"]/n if n else None,
+                      final_pixels=int(final.sum()), vehicle_leak_pixels=int((final & ~valid).sum()), **details)
+        records.append(record)
+        results.append((path.stem, final))
+        if index in (0, 15, 35, 50, 75, 90, 99):
+            panels = [rgb.copy(), overlay(rgb, old), overlay(rgb, final)]
+            for panel, label in zip(panels, (f"SOURCE FRAME {index}", "EXP15 OLD ROAD MASK", "EXP35 SAM3.1 ROAD + PAINT")):
+                cv2.putText(panel, label, (8, 24), cv2.FONT_HERSHEY_SIMPLEX, .6, (255, 255, 255), 2)
+            previews.append(np.concatenate(panels, axis=1))
+            zooms.append(np.concatenate([cv2.resize(p[235:350, :290], (580, 230)) for p in panels], axis=1))
+    args.output.mkdir(parents=True)
+    for stem, mask in results:
+        if not cv2.imwrite(str(args.output/f"{stem}.png"), mask.astype(np.uint8)*255):
+            raise IOError(stem)
+    preview = args.output/"road_mask_check.jpg"
+    zoom = args.output/"left_boundary_check.jpg"
+    cv2.imwrite(str(preview), cv2.cvtColor(np.concatenate(previews), cv2.COLOR_RGB2BGR))
+    cv2.imwrite(str(zoom), cv2.cvtColor(np.concatenate(zooms), cv2.COLOR_RGB2BGR))
+    sums = {label: sum(r["covered_candidate_pixels"][label] for r in records)
+            for label in ("old", "road_no_erosion", "sam_lane", "final")}
+    total = sum(r["candidate_pixels"] for r in records)
+    flagged = [r["index"] for r in records if r["final_candidate_coverage"] is None or r["final_candidate_coverage"] < .98]
+    summary = dict(image_count=len(paths), image_resolution_wh=list(rgb.shape[:2][::-1]),
+                   candidate_pixels=total, aggregate_candidate_coverage={k: v/total for k, v in sums.items()},
+                   minimum_frame_candidate_coverage=min(r["final_candidate_coverage"] for r in records if r["candidate_pixels"]),
+                   frames_below_98_percent=flagged, vehicle_leak_pixels=sum(r["vehicle_leak_pixels"] for r in records))
+    report = dict(method="sam31_uneroded_main_carriageway_plus_nearby_observed_lane_markings",
+                  summary=summary, records=records, mask_sha256=inputs,
+                  maximum_lane_gap_rgb_pixels=16, no_hough_mask_generation=True,
+                  no_gaussian_or_camera_changes=True,
+                  mask_convention="255=static main-carriageway road including lane paint; 0=other/vehicle",
+                  limitations=["Candidate coverage is an image-based check, NOT annotated segmentation IoU or proof of all road coverage.",
+                               "Main road and lane boundaries require visual checking; small SAM paint-edge errors can remain.",
+                               "Disconnected side roads are intentionally excluded, not silently flattened as the main carriageway."],
+                  raw_road_metadata=json.loads((args.road_masks/"metadata.json").read_text()),
+                  raw_lane_metadata=json.loads((args.lane_masks/"metadata.json").read_text()))
+    (args.output/"mask_completeness_report.json").write_text(json.dumps(report, indent=2)+"\n")
+    print(json.dumps(summary, indent=2), flush=True)
+
+
+if __name__ == "__main__":
+    main()
